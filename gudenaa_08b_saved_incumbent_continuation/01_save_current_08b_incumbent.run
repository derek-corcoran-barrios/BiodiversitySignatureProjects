# Save the CURRENT in-memory 08b solution as a complete AMPL MIP start.
#
# IMPORTANT
# ---------
# Run this file at the SAME `ampl:` prompt immediately after the completed
# 08b run, before `reset;`, before loading another model, and before closing
# AMPL.  It serializes the actual current incumbent, including the continuous
# network-flow variables that are not present in the ordinary TSV audit files.
#
# Usage from the project root:
#
#   include "gudenaa_08b_saved_incumbent_continuation/01_save_current_08b_incumbent.run";
#
# Output:
#
#   Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/
#     gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run
#
# The final line of the generated file is `# CHECKPOINT_COMPLETE`.  Do not use
# a checkpoint that lacks this marker.

printf "# Complete incumbent checkpoint generated after the 08b solve.\n" >
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "# Reload only after loading the matching .mod and .dat files.\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "# This file contains the complete discrete assignment and network flows.\n\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

# Explicitly zero every variable first.  The following indexed printf commands
# then write only positive/nonzero values, keeping the checkpoint reasonably
# compact while remaining independent of AMPL's previous state.
printf "let {c in Cells} Selected[c] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(l,c) in AllowedActions} LanduseDecision[l,c] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(l,i,j) in SameHabitatEdges} Contiguity[l,i,j] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {k in RequiredNetworks} CertificateBuilt[k] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {k in RequiredNetworks} NetworkShortfallHa[k] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,c) in EligibleNetworkCells} NetworkCell[k,c] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,p) in EligibleNetworkPatches} NetworkPatch[k,p] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,p) in EligibleNetworkPatches} NetworkRoot[k,p] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,i,j) in NetworkCellArcs} AreaFlowHa[k,i,j] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,c,p) in NetworkCellPatchEdges} CellToPatchFlowHa[k,c,p] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,c,p) in NetworkCellPatchEdges} PatchToCellFlowHa[k,c,p] := 0;\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";
printf "let {(k,p) in EligibleNetworkPatches} CollectedAreaHa[k,p] := 0;\n\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {c in Cells: Selected[c] > 0.5}
  "let Selected[%d] := 1;\n", c >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(l,c) in AllowedActions: LanduseDecision[l,c] > 0.5}
  "let LanduseDecision['%s',%d] := 1;\n", l, c >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(l,i,j) in SameHabitatEdges: Contiguity[l,i,j] > 0.5}
  "let Contiguity['%s',%d,%d] := 1;\n", l, i, j >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {k in RequiredNetworks: CertificateBuilt[k] > 0.5}
  "let CertificateBuilt['%s'] := 1;\n", k >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {k in RequiredNetworks: NetworkShortfallHa[k] > 0.00000001}
  "let NetworkShortfallHa['%s'] := %.12f;\n", k, NetworkShortfallHa[k] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,c) in EligibleNetworkCells: NetworkCell[k,c] > 0.5}
  "let NetworkCell['%s',%d] := 1;\n", k, c >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,p) in EligibleNetworkPatches: NetworkPatch[k,p] > 0.5}
  "let NetworkPatch['%s',%d] := 1;\n", k, p >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,p) in EligibleNetworkPatches: NetworkRoot[k,p] > 0.5}
  "let NetworkRoot['%s',%d] := 1;\n", k, p >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,i,j) in NetworkCellArcs: AreaFlowHa[k,i,j] > 0.00000001}
  "let AreaFlowHa['%s',%d,%d] := %.12f;\n", k, i, j,
  AreaFlowHa[k,i,j] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,c,p) in NetworkCellPatchEdges:
  CellToPatchFlowHa[k,c,p] > 0.00000001}
  "let CellToPatchFlowHa['%s',%d,%d] := %.12f;\n", k, c, p,
  CellToPatchFlowHa[k,c,p] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,c,p) in NetworkCellPatchEdges:
  PatchToCellFlowHa[k,c,p] > 0.00000001}
  "let PatchToCellFlowHa['%s',%d,%d] := %.12f;\n", k, c, p,
  PatchToCellFlowHa[k,c,p] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf {(k,p) in EligibleNetworkPatches: CollectedAreaHa[k,p] > 0.00000001}
  "let CollectedAreaHa['%s',%d] := %.12f;\n", k, p,
  CollectedAreaHa[k,p] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

printf "\n# CHECKPOINT_COMPLETE\n" >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent.run";

# Small, human-readable audit of exactly what was checkpointed.
printf "item\tvalue\n" >
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent_audit.tsv";
printf "network_shortfall_total_ha\t%.8f\n",
  sum {k in RequiredNetworks} NetworkShortfallHa[k] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent_audit.tsv";
printf "warm_footprint_change_ha\t%.8f\n",
  sum {c in Cells} RestorableAreaHa[c] *
    (WarmSelected[c] * (1 - Selected[c]) +
     (1 - WarmSelected[c]) * Selected[c]) >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent_audit.tsv";
printf "repair_quality\t%.10f\n", RepairQuality >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent_audit.tsv";
printf "selected_cells\t%.0f\n", sum {c in Cells} Selected[c] >>
  "Optimization/gudenaa_new_area_200m_global30_constructive_network_repair/gudenaa_new_area_200m_global30_constructive_network_repair_saved_incumbent_audit.tsv";

printf "Saved complete 08b incumbent checkpoint.\n";
printf "Next, the continuation may be run in this or a fresh AMPL session.\n";
